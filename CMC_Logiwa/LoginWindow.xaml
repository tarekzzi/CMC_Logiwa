<Window x:Class="CMC_Logiwa.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CMC Logiwa – Sign in"
        Width="440" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource AppBgBrush}"
        Foreground="{StaticResource TextBrush}" FontFamily="{StaticResource UiFont}" UseLayoutRounding="True">
    <Grid Margin="24">
        <Border Style="{StaticResource Card}" Padding="32">
            <StackPanel>
                <TextBlock Text="CMC Logiwa" FontSize="22" FontWeight="SemiBold" />
                <TextBlock x:Name="lblSubtitle" Text="Sign in with your username and password."
                           Style="{StaticResource MutedText}" Margin="0,4,0,24" />

                <Label Content="_Username" Target="{Binding ElementName=txtUsername}" />
                <TextBox x:Name="txtUsername" Margin="0,0,0,16" MaxLength="50" />

                <Label Content="_Password" Target="{Binding ElementName=txtPassword}" />
                <PasswordBox x:Name="txtPassword" Margin="0,0,0,12" />

                <StackPanel x:Name="panelConfirm" Visibility="Collapsed">
                    <Label Content="_Confirm password" Target="{Binding ElementName=txtConfirm}" />
                    <PasswordBox x:Name="txtConfirm" Margin="0,0,0,12" />
                </StackPanel>

                <TextBlock x:Name="lblStatus" TextWrapping="Wrap" Margin="0,0,0,12" Visibility="Collapsed" />

                <Button x:Name="btnLogin" Content="Sign in" Style="{StaticResource PrimaryButton}"
                        MinHeight="42" IsDefault="True" Click="btnLogin_Click" />
                <Button x:Name="btnCancel" Content="Cancel" Style="{StaticResource SecondaryButton}"
                        MinHeight="42" Margin="0,8,0,0" IsCancel="True" Click="btnCancel_Click" />

                <TextBlock x:Name="lblEnvironment" Style="{StaticResource MutedText}" TextWrapping="Wrap"
                           Margin="0,20,0,0" />
                <Button x:Name="btnDbSettings" Content="Database settings…" Style="{StaticResource SecondaryButton}"
                        MinHeight="36" Margin="0,8,0,0" Click="btnDbSettings_Click" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
