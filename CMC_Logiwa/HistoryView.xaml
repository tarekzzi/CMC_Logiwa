<UserControl x:Class="CMC_Logiwa.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="DiffCell" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="WrapCell" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </UserControl.Resources>

    <Border Style="{StaticResource Card}" Padding="0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" MinHeight="160" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Filters -->
            <Grid Grid.Row="0" Margin="20,16,20,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="200" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,14,0">
                    <Label Content="Tracking number / order / client" Target="{Binding ElementName=txtSearch}" />
                    <TextBox x:Name="txtSearch" Tag="Part of a tracking number, job number, order code or client" KeyDown="Filter_KeyDown" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,14,0">
                    <Label Content="Received from" Target="{Binding ElementName=dpFrom}" />
                    <DatePicker x:Name="dpFrom" Width="140" MinHeight="38" VerticalContentAlignment="Center" />
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="0,0,14,0">
                    <Label Content="To" Target="{Binding ElementName=dpTo}" />
                    <DatePicker x:Name="dpTo" Width="140" MinHeight="38" VerticalContentAlignment="Center" />
                </StackPanel>
                <StackPanel Grid.Column="3" Margin="0,0,14,0">
                    <Label Content="Machine result" Target="{Binding ElementName=cboMachine}" />
                    <ComboBox x:Name="cboMachine" Width="140" SelectedIndex="0">
                        <ComboBoxItem Content="All" />
                        <ComboBoxItem Content="Completed" Tag="Completed" />
                        <ComboBoxItem Content="Failed" Tag="Failed" />
                        <ComboBoxItem Content="Removed" Tag="Removed" />
                        <ComboBoxItem Content="In progress" Tag="InProgress" />
                        <ComboBoxItem Content="Not packed" Tag="NotPacked" />
                    </ComboBox>
                </StackPanel>
                <StackPanel Grid.Column="4" Margin="0,0,14,0">
                    <Label Content="Logiwa status" Target="{Binding ElementName=cboLogiwa}" />
                    <ComboBox x:Name="cboLogiwa" Width="130" SelectedIndex="0">
                        <ComboBoxItem Content="All" />
                        <ComboBoxItem Content="Open" Tag="Open" />
                        <ComboBoxItem Content="Shipped" Tag="Shipped" />
                        <ComboBoxItem Content="Cancelled" Tag="Cancelled" />
                        <ComboBoxItem Content="On hold" Tag="OnHold" />
                        <ComboBoxItem Content="Unknown" Tag="Unknown" />
                    </ComboBox>
                </StackPanel>
                <StackPanel Grid.Column="5" VerticalAlignment="Bottom">
                    <CheckBox x:Name="chkDiff" Content="Differences only" MinHeight="38" VerticalContentAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.ColumnSpan="6" Orientation="Horizontal" Margin="0,12,0,0">
                    <Button x:Name="btnSearch" Content="_Search" Style="{StaticResource PrimaryButton}" MinWidth="100" MinHeight="38" Margin="0,0,10,0" Click="btnSearch_Click" />
                    <Button x:Name="btnClear" Content="Clear" MinWidth="80" MinHeight="38" Margin="0,0,10,0" Click="btnClear_Click" />
                    <Button x:Name="btnExport" Content="Export CSV..." MinWidth="110" MinHeight="38" Click="btnExport_Click" />
                </StackPanel>
            </Grid>

            <!-- The list -->
            <Border Grid.Row="1" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="0,1,0,0">
                <Grid>
                    <DataGrid x:Name="gridHistory" SelectionChanged="gridHistory_SelectionChanged" VerticalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Received (local)" Binding="{Binding ReceivedText}" Width="125" />
                            <DataGridTextColumn Header="Tracking number" Binding="{Binding TrackingNumber}" Width="150" />
                            <DataGridTextColumn Header="Order" Binding="{Binding OrderCode}" Width="110" />
                            <DataGridTextColumn Header="Client" Binding="{Binding ClientCode}" Width="80" />
                            <DataGridTextColumn Header="Machine result" Binding="{Binding MachineText}" Width="100" />
                            <DataGridTextColumn Header="Logiwa status" Binding="{Binding LogiwaStatus}" Width="110" />
                            <DataGridTextColumn Header="Difference" Binding="{Binding Difference}" Width="*" MinWidth="220" ElementStyle="{StaticResource DiffCell}" />
                            <DataGridTextColumn Header="Received (UTC)" Binding="{Binding ReceivedUtcText}" Width="125" />
                            <DataGridTextColumn Header="Logiwa (UTC)" Binding="{Binding LogiwaText}" Width="125" />
                            <DataGridTextColumn Header="Packed" Binding="{Binding CompletedText}" Width="150" />
                            <DataGridTextColumn Header="Measured" Binding="{Binding MeasuredText}" Width="200" />
                            <DataGridTextColumn Header="Machine" Binding="{Binding MachineId}" Width="70" />
                            <DataGridTextColumn Header="Operator" Binding="{Binding Operator}" Width="90" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock x:Name="lblEmpty" Style="{StaticResource MutedText}" HorizontalAlignment="Center" VerticalAlignment="Center"
                               TextAlignment="Center" IsHitTestVisible="False" Visibility="Collapsed" />
                </Grid>
            </Border>

            <!-- Totals + the selected box -->
            <Border Grid.Row="2" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="0,1,0,0" Padding="20,12,20,14">
                <StackPanel>
                    <TextBlock x:Name="lblCount" Style="{StaticResource MutedText}" FontSize="12.5" TextWrapping="Wrap" Margin="0,0,0,2" />
                    <TextBlock x:Name="lblTotals" Style="{StaticResource MutedText}" FontSize="12.5" TextWrapping="Wrap" Margin="0,0,0,8" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="lblHistoryTitle" Text="Select a row to see every step the machine reported for it." Style="{StaticResource MutedText}" FontSize="12.5" TextWrapping="Wrap" VerticalAlignment="Center" />
                        <Button x:Name="btnCheck" Grid.Column="1" Content="Check in Logiwa now" MinHeight="34" Margin="12,0,0,0" IsEnabled="False" Click="btnCheck_Click"
                                ToolTip="Asks Logiwa for the status of the selected box right now and stores it." />
                    </Grid>
                    <ListBox x:Name="lstHistory" MaxHeight="130" Margin="0,8,0,0" BorderThickness="0" Background="Transparent"
                             FontFamily="{StaticResource MonoFont}" FontSize="13" Visibility="Collapsed"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="160" />
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding DateTimeText}" Foreground="{StaticResource MutedBrush}" />
                                    <TextBlock Grid.Column="1" Text="{Binding EventType}" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="2" Text="{Binding Detail}" TextWrapping="Wrap" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
