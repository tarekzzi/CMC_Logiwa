<Window x:Class="CMC_Logiwa.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:CMC_Logiwa"
        Title="CMC Logiwa"
        Width="1280" Height="880" MinWidth="1000" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource AppBgBrush}"
        Foreground="{StaticResource TextBrush}" FontFamily="{StaticResource UiFont}" FontSize="14"
        UseLayoutRounding="True" SnapsToDevicePixels="True">

    <Window.Resources>
        <!-- Log rows: alternating shading, blue when selected. -->
        <Style x:Key="LogItem" TargetType="ListBoxItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="bd" Background="Transparent" Padding="14,4">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource RowAltBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource HoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentSoftBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="LogRow">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="104" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Time}" FontFamily="{StaticResource MonoFont}" FontSize="13"
                           Foreground="{StaticResource MutedBrush}" />
                <TextBlock x:Name="msg" Grid.Column="1" Text="{Binding Message}" TextWrapping="Wrap"
                           FontFamily="{StaticResource MonoFont}" FontSize="13" />
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Kind}" Value="Error">
                    <Setter TargetName="msg" Property="Foreground" Value="{StaticResource DangerBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Sent">
                    <Setter TargetName="msg" Property="Foreground" Value="{StaticResource AccentBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Info">
                    <Setter TargetName="msg" Property="Foreground" Value="{StaticResource MutedBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">

        <!-- ===== Environment banner: red for PRO (real orders, real cartons), calm for DEV ===== -->
        <Border x:Name="envBanner" Visibility="Collapsed" Padding="24,5">
            <TextBlock x:Name="envBannerText" FontWeight="SemiBold" FontSize="13" HorizontalAlignment="Center" />
        </Border>

        <!-- ===== Backend health: red while the web VM / Logiwa / webhooks have a problem, green for a while after it is solved ===== -->
        <Border x:Name="healthBanner" Visibility="Collapsed" Padding="24,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="healthBannerText" Grid.Column="0" FontWeight="SemiBold" FontSize="14"
                           TextWrapping="Wrap" VerticalAlignment="Center" />
                <Button x:Name="btnHealthCheckNow" Grid.Column="1" Content="Check now" Margin="16,0,0,0"
                        Style="{StaticResource SecondaryButton}"
                        VerticalAlignment="Center" Click="btnHealthCheckNow_Click" />
            </Grid>
        </Border>

        <!-- ===== Header ===== -->
        <Border Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="0,0,0,1" Padding="24,0">
            <Grid MinHeight="68">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="CMC Logiwa" FontSize="22" FontWeight="SemiBold"
                           VerticalAlignment="Center" />
                <TextBlock x:Name="lblSync" Grid.Column="1" Style="{StaticResource MutedText}" TextTrimming="CharacterEllipsis"
                           HorizontalAlignment="Right" VerticalAlignment="Center" Margin="16,0,20,0" />
                <TextBlock x:Name="lblSession" Grid.Column="2" Style="{StaticResource MutedText}"
                           VerticalAlignment="Center" Margin="0,0,20,0" />

                <Border x:Name="pill" Grid.Column="3" CornerRadius="17" Padding="14,0" Height="34"
                        VerticalAlignment="Center" Margin="0,0,12,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse x:Name="pillDot" Width="9" Height="9" Margin="0,1,8,0" />
                        <TextBlock x:Name="pillText" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>

                <Button x:Name="btnSettings" Grid.Column="4" Content="_Settings" MinWidth="88" VerticalAlignment="Center" Margin="0,0,10,0"
                        Style="{StaticResource SecondaryButton}" Click="btnSettings_Click" />

                <Button x:Name="btnExit" Grid.Column="5" Content="E_xit" MinWidth="76" VerticalAlignment="Center"
                        Style="{StaticResource SecondaryButton}" Click="btnExit_Click" />
            </Grid>
        </Border>

        </StackPanel>

        <!-- ===== Body: Overview | Machine | Errors ===== -->
        <TabControl Grid.Row="1" x:Name="tabs" Margin="24,14,24,20">
          <TabItem Header="Overview">
            <local:OverviewView x:Name="overview" />
          </TabItem>

          <TabItem Header="Machine">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Machine connection" Style="{StaticResource CardTitle}" />

                            <Label Content="_IP address" Target="{Binding ElementName=txtIPAddress}" />
                            <TextBox x:Name="txtIPAddress" IsReadOnly="True" Text="10.2.1.201" Margin="0,0,0,12" />

                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <Label Content="_Port" Target="{Binding ElementName=txtPort}" />
                                    <TextBox x:Name="txtPort" IsReadOnly="True" Text="9200" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <Label Content="_Machine ID" Target="{Binding ElementName=txtMachineId}" />
                                    <TextBox x:Name="txtMachineId" IsReadOnly="True" Text="002" />
                                </StackPanel>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button x:Name="btnStartConnection" Grid.Column="0" Content="_Connect"
                                        Style="{StaticResource PrimaryButton}" Click="btnStartConnection_Click" />
                                <Button x:Name="btnEndConnection" Grid.Column="2" Content="_Disconnect"
                                        Style="{StaticResource SecondaryButton}" Click="btnEndConnection_Click" />
                            </Grid>
                            <TextBlock x:Name="lblMachineSource" Style="{StaticResource MutedText}" FontSize="12.5"
                                       TextWrapping="Wrap" Margin="0,12,0,0"
                                       Text="Machine ID, address, port and automatic reconnect are set in Settings > Machine." />
                            <TextBlock x:Name="lblLink" Style="{StaticResource MutedText}" FontSize="12.5"
                                       TextWrapping="Wrap" Margin="0,6,0,0" />

                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Duplicate scans" Style="{StaticResource CardTitle}" />
                            <TextBlock Text="Scanned again after processing. Reset to process it again, or reject."
                                       Style="{StaticResource MutedText}" FontSize="12.5" TextWrapping="Wrap"
                                       Margin="0,0,0,8" />

                            <ListBox x:Name="lstDuplicates" Height="150" SelectionMode="Single" Margin="0,0,0,6"
                                     FontFamily="{StaticResource MonoFont}" FontSize="13"
                                     BorderBrush="{StaticResource BorderBrushSoft}" />
                            <TextBlock x:Name="lblDuplicatesHint" Style="{StaticResource MutedText}" FontSize="12.5"
                                       Margin="0,0,0,12" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button x:Name="btnResetSelected" Grid.Column="0" Content="Rese_t"
                                        Style="{StaticResource PrimaryButton}" Click="btnResetSelected_Click" />
                                <Button x:Name="btnRejectSelected" Grid.Column="2" Content="Re_ject"
                                        Style="{StaticResource SecondaryButton}" Click="btnRejectSelected_Click" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Reset order" Style="{StaticResource CardTitle}" />

                            <Label Content="_Tracking no." Target="{Binding ElementName=txtResetOrderNumber}" />
                            <TextBox x:Name="txtResetOrderNumber" Margin="0,0,0,16" />

                            <Button x:Name="btnResetOrderNumber" Content="_Reset order"
                                    Style="{StaticResource DangerButton}" Click="btnResetOrderNumber_Click" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Message log -->
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="20,16,20,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="Message log" FontSize="16" FontWeight="SemiBold" />
                            <TextBlock x:Name="lblLogCount" Style="{StaticResource MutedText}" FontSize="12.5" Margin="0,2,0,0" />
                        </StackPanel>

                        <TextBox x:Name="txtLogFilter" Grid.Column="2" Width="260" Tag="Filter log   (Ctrl+F)"
                                 Margin="0,0,10,0" TextChanged="txtLogFilter_TextChanged"
                                 PreviewKeyDown="txtLogFilter_PreviewKeyDown" />
                        <Button x:Name="btnExportLog" Grid.Column="3" Content="Export…" MinWidth="84"
                                Margin="0,0,8,0" Click="btnExportLog_Click" />
                        <Button x:Name="btnClearLog" Grid.Column="4" Content="Clear log" MinWidth="84"
                                Click="btnClearLog_Click" />
                    </Grid>

                    <Border Grid.Row="1" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="0,1,0,0"
                            CornerRadius="0,0,10,10" ClipToBounds="True">
                        <Grid>
                            <ListBox x:Name="listBoxLogs" BorderThickness="0" Background="Transparent"
                                     AlternationCount="2" SelectionMode="Extended"
                                     ItemContainerStyle="{StaticResource LogItem}"
                                     ItemTemplate="{StaticResource LogRow}"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     VirtualizingPanel.IsVirtualizing="True" />
                            <TextBlock x:Name="lblLogEmpty" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       TextAlignment="Center" Style="{StaticResource MutedText}" IsHitTestVisible="False" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
          </TabItem>

          <TabItem Header="Errors">
            <local:ErrorsView x:Name="errors" />
          </TabItem>
        </TabControl>
    </Grid>
</Window>
