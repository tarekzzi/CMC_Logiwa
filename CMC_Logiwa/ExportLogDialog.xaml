<Window x:Class="CMC_Logiwa.ExportLogDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Export message log"
        Width="440" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource SurfaceBrush}"
        Foreground="{StaticResource TextBrush}" FontFamily="{StaticResource UiFont}" UseLayoutRounding="True">
    <StackPanel Margin="28,24,28,24">
        <TextBlock Text="Which lines do you want to export?" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,16" />

        <RadioButton GroupName="scope" x:Name="rbAll" Margin="0,0,0,12" />
        <RadioButton GroupName="scope" x:Name="rbFiltered" Margin="0,0,0,12" />

        <StackPanel Orientation="Horizontal">
            <RadioButton GroupName="scope" x:Name="rbLast" Content="_Last" VerticalAlignment="Center" />
            <TextBox x:Name="txtLast" Width="90" Margin="10,0,10,0" VerticalContentAlignment="Center"
                     GotKeyboardFocus="txtLast_GotKeyboardFocus" TextChanged="txtLast_TextChanged"
                     AutomationProperties.Name="Number of lines" />
            <TextBlock x:Name="lblLines" VerticalAlignment="Center" Style="{StaticResource MutedText}" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,28,0,0">
            <Button Content="Cancel" IsCancel="True" MinWidth="92" Margin="0,0,8,0" />
            <Button x:Name="btnOk" Content="Choose file…" IsDefault="True" MinWidth="130"
                    Style="{StaticResource PrimaryButton}" Click="btnOk_Click" />
        </StackPanel>
    </StackPanel>
</Window>
