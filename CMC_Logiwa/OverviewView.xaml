<UserControl x:Class="CMC_Logiwa.OverviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:CMC_Logiwa">
    <UserControl.Resources>
        <Style x:Key="StatusCell" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="Failed">
                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Removed">
                    <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,6,0">

            <!-- Counts: available now, processed today / week / month -->
            <UniformGrid Columns="4" Rows="1">
                <Border Style="{StaticResource Card}" Margin="0,0,16,0" BorderBrush="{StaticResource AccentBrush}" BorderThickness="2">
                    <StackPanel>
                        <TextBlock Text="Available to process" Style="{StaticResource MutedText}" FontWeight="SemiBold" />
                        <TextBlock x:Name="numAvailable" Text="–" Style="{StaticResource BigNumber}" Foreground="{StaticResource AccentBrush}" Margin="0,6,0,2" />
                        <TextBlock x:Name="subAvailable" Style="{StaticResource MutedText}" FontSize="12.5" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,0,16,0">
                    <StackPanel>
                        <TextBlock Text="Processed today" Style="{StaticResource MutedText}" FontWeight="SemiBold" />
                        <TextBlock x:Name="numToday" Text="–" Style="{StaticResource BigNumber}" Margin="0,6,0,2" />
                        <TextBlock x:Name="subToday" Style="{StaticResource MutedText}" FontSize="12.5" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,0,16,0">
                    <StackPanel>
                        <TextBlock Text="Processed this week" Style="{StaticResource MutedText}" FontWeight="SemiBold" />
                        <TextBlock x:Name="numWeek" Text="–" Style="{StaticResource BigNumber}" Margin="0,6,0,2" />
                        <TextBlock x:Name="subWeek" Style="{StaticResource MutedText}" FontSize="12.5" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Processed this month" Style="{StaticResource MutedText}" FontWeight="SemiBold" />
                        <TextBlock x:Name="numMonth" Text="–" Style="{StaticResource BigNumber}" Margin="0,6,0,2" />
                        <TextBlock x:Name="subMonth" Style="{StaticResource MutedText}" FontSize="12.5" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Filters for everything below -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" MinWidth="200" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,14,0">
                        <Label Content="Period" Target="{Binding ElementName=cboPeriod}" />
                        <ComboBox x:Name="cboPeriod" Width="150" SelectionChanged="Filter_Changed">
                            <ComboBoxItem Content="Today" IsSelected="True" />
                            <ComboBoxItem Content="Yesterday" />
                            <ComboBoxItem Content="Last 7 days" />
                            <ComboBoxItem Content="This week" />
                            <ComboBoxItem Content="Last 30 days" />
                            <ComboBoxItem Content="This month" />
                            <ComboBoxItem Content="Custom range" />
                        </ComboBox>
                    </StackPanel>

                    <StackPanel x:Name="pnlFrom" Grid.Column="1" Margin="0,0,14,0" Visibility="Collapsed">
                        <Label Content="From" Target="{Binding ElementName=dpFrom}" />
                        <DatePicker x:Name="dpFrom" Width="140" MinHeight="38" VerticalContentAlignment="Center" SelectedDateChanged="Filter_Changed" />
                    </StackPanel>
                    <StackPanel x:Name="pnlTo" Grid.Column="2" Margin="0,0,14,0" Visibility="Collapsed">
                        <Label Content="To" Target="{Binding ElementName=dpTo}" />
                        <DatePicker x:Name="dpTo" Width="140" MinHeight="38" VerticalContentAlignment="Center" SelectedDateChanged="Filter_Changed" />
                    </StackPanel>

                    <StackPanel Grid.Column="3" Margin="0,0,14,0">
                        <Label Content="Client" Target="{Binding ElementName=cboClient}" />
                        <ComboBox x:Name="cboClient" Width="150" SelectionChanged="Filter_Changed" />
                    </StackPanel>

                    <StackPanel Grid.Column="4" Margin="0,0,14,0">
                        <Label Content="Tracking number / job / order" Target="{Binding ElementName=txtSearch}" />
                        <TextBox x:Name="txtSearch" Tag="Part of a tracking number, job number or order code" KeyDown="Search_KeyDown" />
                    </StackPanel>

                    <StackPanel Grid.Column="5" Margin="0,0,10,0" VerticalAlignment="Bottom">
                        <Button Content="_Search" Style="{StaticResource PrimaryButton}" MinWidth="100" MinHeight="38" Click="btnSearch_Click" />
                    </StackPanel>
                    <StackPanel Grid.Column="6" VerticalAlignment="Bottom">
                        <Button Content="Clear" MinWidth="80" MinHeight="38" Click="btnClear_Click" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Speed for the chosen period -->
            <UniformGrid Columns="4" Rows="1" Margin="0,16,0,0">
                <Border Style="{StaticResource Card}" Margin="0,0,16,0">
                    <StackPanel>
                        <TextBlock x:Name="lblPeriodCompleted" Text="Boxes completed" Style="{StaticResource MutedText}" FontWeight="SemiBold" />
                        <TextBlock x:Name="numCompleted" Text="–" Style="{StaticResource BigNumber}" Margin="0,6,0,2" />
                        <TextBlock x:Name="subCompleted" Style="{StaticResource MutedText}" FontSize="12.5" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,0,16,0">
                    <StackPanel>
                        <TextBlock Text="Boxes per hour" Style="{StaticResource MutedText}" FontWeight="SemiBold" />
                        <TextBlock x:Name="numPerHour" Text="–" Style="{StaticResource BigNumber}" Margin="0,6,0,2" />
                        <TextBlock x:Name="subPerHour" Style="{StaticResource MutedText}" FontSize="12.5" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,0,16,0">
                    <StackPanel>
                        <TextBlock Text="Average time per box" Style="{StaticResource MutedText}" FontWeight="SemiBold" />
                        <TextBlock x:Name="numAvgTime" Text="–" Style="{StaticResource BigNumber}" Margin="0,6,0,2" />
                        <TextBlock x:Name="subAvgTime" Style="{StaticResource MutedText}" FontSize="12.5" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Busiest hour" Style="{StaticResource MutedText}" FontWeight="SemiBold" />
                        <TextBlock x:Name="numPeak" Text="–" Style="{StaticResource BigNumber}" Margin="0,6,0,2" />
                        <TextBlock x:Name="subPeak" Style="{StaticResource MutedText}" FontSize="12.5" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Charts -->
            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock x:Name="lblChart1" Text="Boxes completed" Style="{StaticResource CardTitle}" Margin="0,0,0,2" />
                        <TextBlock x:Name="lblChart1Sub" Style="{StaticResource MutedText}" FontSize="12.5" Margin="0,0,0,8"
                                   Text="Blue = completed, red = failed or removed" />
                        <local:BarLineChart x:Name="chartThroughput" Height="230" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock x:Name="lblChart2" Text="Average time per box (seconds)" Style="{StaticResource CardTitle}" Margin="0,0,0,2" />
                        <TextBlock Style="{StaticResource MutedText}" FontSize="12.5" Margin="0,0,0,8"
                                   Text="From the accepted scan to the machine's END message" />
                        <local:BarLineChart x:Name="chartSpeed" Height="230" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Operators -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="Boxes per operator" Style="{StaticResource CardTitle}" Margin="0,0,0,2" />
                    <TextBlock Style="{StaticResource MutedText}" FontSize="12.5" Margin="0,0,0,8"
                               Text="Bars = boxes completed (red = failed or removed), orange line = average seconds per box" />
                    <local:BarLineChart x:Name="chartOperators" Height="200" />
                </StackPanel>
            </Border>

            <!-- Lists -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,6" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="400" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="20,16,20,14">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="rbFinished" Content="Finished boxes" IsChecked="True" GroupName="list" Margin="0,0,24,0"
                                         FontSize="15" FontWeight="SemiBold" Checked="List_Switched" />
                            <RadioButton x:Name="rbAvailable" Content="Available jobs" GroupName="list" Margin="0,0,24,0"
                                         FontSize="15" FontWeight="SemiBold" Checked="List_Switched" />
                            <RadioButton x:Name="rbStops" Content="Stops" GroupName="list"
                                         FontSize="15" FontWeight="SemiBold" Checked="List_Switched" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="btnExport" Content="Export CSV…" MinHeight="34" Padding="14,0" Margin="0,0,16,0"
                                    VerticalAlignment="Center" Click="btnExport_Click" ToolTip="Saves every box of the chosen period and filter, not only the newest 500" />
                            <ComboBox x:Name="cboStopMin" Width="150" Margin="0,0,16,0" SelectionChanged="Filter_Changed" VerticalAlignment="Center" Visibility="Collapsed">
                                <ComboBoxItem Content="Stops of 5+ min" />
                                <ComboBoxItem Content="Stops of 10+ min" IsSelected="True" />
                                <ComboBoxItem Content="Stops of 15+ min" />
                                <ComboBoxItem Content="Stops of 30+ min" />
                            </ComboBox>
                            <ComboBox x:Name="cboStatus" Width="130" Margin="0,0,16,0" SelectionChanged="Filter_Changed" VerticalAlignment="Center">
                                <ComboBoxItem Content="All results" IsSelected="True" />
                                <ComboBoxItem Content="Completed" />
                                <ComboBoxItem Content="Failed" />
                                <ComboBoxItem Content="Removed" />
                            </ComboBox>
                            <TextBlock x:Name="lblListInfo" Style="{StaticResource MutedText}" FontSize="12.5" VerticalAlignment="Center" Margin="0,0,16,0" />
                            <TextBlock x:Name="lblUpdated" Style="{StaticResource MutedText}" FontSize="12.5" VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="1" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="0,1,0,0">
                        <Grid>
                            <DataGrid x:Name="gridFinished" VerticalScrollBarVisibility="Auto">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Finished" Binding="{Binding FinishedText}" Width="150" />
                                    <DataGridTextColumn Header="Tracking number" Binding="{Binding TrackingNumber}" Width="*" MinWidth="170" />
                                    <DataGridTextColumn Header="Order" Binding="{Binding OrderCode}" Width="110" />
                                    <DataGridTextColumn Header="Client" Binding="{Binding ClientCode}" Width="90" />
                                    <DataGridTextColumn Header="Result" Binding="{Binding Status}" Width="90" ElementStyle="{StaticResource StatusCell}" />
                                    <DataGridTextColumn Header="Time" Binding="{Binding DurationText}" Width="70" />
                                    <DataGridTextColumn Header="Size (mm)" Binding="{Binding SizeText}" Width="130" />
                                    <DataGridTextColumn Header="Weight" Binding="{Binding WeightText}" Width="80" />
                                    <DataGridTextColumn Header="Operator" Binding="{Binding Operator}" Width="100" />
                                </DataGrid.Columns>
                            </DataGrid>

                            <DataGrid x:Name="gridAvailable" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Tracking number" Binding="{Binding TrackingNumber}" Width="*" MinWidth="200" />
                                    <DataGridTextColumn Header="Order" Binding="{Binding OrderCode}" Width="180" />
                                    <DataGridTextColumn Header="Client" Binding="{Binding ClientCode}" Width="140" />
                                    <DataGridTextColumn Header="Received (local)" Binding="{Binding ReceivedText}" Width="140" />
                                    <DataGridTextColumn Header="Received (UTC)" Binding="{Binding ReceivedUtcText}" Width="140" />
                                    <DataGridTextColumn Header="Logiwa (UTC)" Binding="{Binding LogiwaText}" Width="140" />
                                </DataGrid.Columns>
                            </DataGrid>
                            <DataGrid x:Name="gridStops" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Last box before the stop" Binding="{Binding StoppedText}" Width="220" />
                                    <DataGridTextColumn Header="Next box finished" Binding="{Binding ResumedText}" Width="220" />
                                    <DataGridTextColumn Header="Quiet for" Binding="{Binding LengthText}" Width="*" MinWidth="120" />
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock x:Name="lblEmpty" Style="{StaticResource MutedText}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" Visibility="Collapsed" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
