<UserControl x:Class="CMC_Logiwa.OverviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Figures -->
        <UniformGrid Grid.Row="0" Columns="4" Rows="1">
            <Border Style="{StaticResource Card}" Margin="0,0,16,0" BorderBrush="{StaticResource AccentBrush}" BorderThickness="2">
                <StackPanel>
                    <TextBlock Text="Available to process" Style="{StaticResource MutedText}" FontWeight="SemiBold" />
                    <TextBlock x:Name="numAvailable" Text="–" Style="{StaticResource BigNumber}" Foreground="{StaticResource AccentBrush}" Margin="0,6,0,2" />
                    <TextBlock x:Name="subAvailable" Style="{StaticResource MutedText}" FontSize="12.5" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,16,0">
                <StackPanel>
                    <TextBlock Text="Processed today" Style="{StaticResource MutedText}" FontWeight="SemiBold" />
                    <TextBlock x:Name="numToday" Text="–" Style="{StaticResource BigNumber}" Margin="0,6,0,2" />
                    <TextBlock x:Name="subToday" Style="{StaticResource MutedText}" FontSize="12.5" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,16,0">
                <StackPanel>
                    <TextBlock Text="Processed this week" Style="{StaticResource MutedText}" FontWeight="SemiBold" />
                    <TextBlock x:Name="numWeek" Text="–" Style="{StaticResource BigNumber}" Margin="0,6,0,2" />
                    <TextBlock x:Name="subWeek" Style="{StaticResource MutedText}" FontSize="12.5" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Processed this month" Style="{StaticResource MutedText}" FontWeight="SemiBold" />
                    <TextBlock x:Name="numMonth" Text="–" Style="{StaticResource BigNumber}" Margin="0,6,0,2" />
                    <TextBlock x:Name="subMonth" Style="{StaticResource MutedText}" FontSize="12.5" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- Jobs a scan would accept now -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="20,16,20,14">
                    <StackPanel>
                        <TextBlock Text="Available jobs" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock x:Name="lblAvailableInfo" Style="{StaticResource MutedText}" FontSize="12.5" Margin="0,2,0,0" />
                    </StackPanel>
                    <TextBlock x:Name="lblUpdated" Style="{StaticResource MutedText}" FontSize="12.5"
                               HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>

                <Border Grid.Row="1" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="0,1,0,0">
                    <Grid>
                        <DataGrid x:Name="gridAvailable">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Tracking number" Binding="{Binding TrackingNumber}" Width="*" MinWidth="200" />
                                <DataGridTextColumn Header="Order" Binding="{Binding OrderCode}" Width="180" />
                                <DataGridTextColumn Header="Client" Binding="{Binding ClientCode}" Width="140" />
                                <DataGridTextColumn Header="Received" Binding="{Binding ReceivedText}" Width="170" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock x:Name="lblEmpty" Text="No jobs are waiting for the machine." Style="{StaticResource MutedText}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" Visibility="Collapsed" />
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
