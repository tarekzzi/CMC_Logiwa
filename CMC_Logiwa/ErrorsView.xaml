<UserControl x:Class="CMC_Logiwa.ErrorsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="StatusCell" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="Removed">
                    <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="WrapCell" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </UserControl.Resources>

    <Border Style="{StaticResource Card}" Padding="0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" MinHeight="160" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Filters -->
            <Grid Grid.Row="0" Margin="20,16,20,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="220" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,14,0">
                    <Label Content="Tracking number / job / order" Target="{Binding ElementName=txtSearch}" />
                    <TextBox x:Name="txtSearch" Tag="Part of a tracking number, job number or order code" KeyDown="Filter_KeyDown" />
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="0,0,14,0">
                    <Label Content="From" Target="{Binding ElementName=dpFrom}" />
                    <DatePicker x:Name="dpFrom" Width="150" MinHeight="38" VerticalContentAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="2" Margin="0,0,14,0">
                    <Label Content="To" Target="{Binding ElementName=dpTo}" />
                    <DatePicker x:Name="dpTo" Width="150" MinHeight="38" VerticalContentAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="3" Margin="0,0,10,0" VerticalAlignment="Bottom">
                    <Button x:Name="btnSearch" Content="_Search" Style="{StaticResource PrimaryButton}" MinWidth="100" MinHeight="38" Click="btnSearch_Click" />
                </StackPanel>
                <StackPanel Grid.Column="4" VerticalAlignment="Bottom">
                    <Button x:Name="btnClear" Content="Clear" MinWidth="80" MinHeight="38" Click="btnClear_Click" />
                </StackPanel>
            </Grid>

            <!-- Errors -->
            <Border Grid.Row="1" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="0,1,0,0">
                <Grid>
                    <DataGrid x:Name="gridErrors" SelectionChanged="gridErrors_SelectionChanged" VerticalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="When" Binding="{Binding EventAtText}" Width="150" />
                            <DataGridTextColumn Header="Tracking number" Binding="{Binding TrackingNumber}" Width="170" />
                            <DataGridTextColumn Header="Order" Binding="{Binding OrderCode}" Width="90" />
                            <DataGridTextColumn Header="Result" Binding="{Binding Status}" Width="90" ElementStyle="{StaticResource StatusCell}" />
                            <DataGridTextColumn Header="Code" Binding="{Binding EventCode}" Width="60" />
                            <DataGridTextColumn Header="Reason from the machine" Binding="{Binding Reason}" Width="*" MinWidth="220" ElementStyle="{StaticResource WrapCell}" />
                            <DataGridTextColumn Header="Measured" Binding="{Binding MeasuredText}" Width="215" />
                            <DataGridTextColumn Header="Machine" Binding="{Binding MachineId}" Width="75" />
                            <DataGridTextColumn Header="Operator" Binding="{Binding Operator}" Width="95" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock x:Name="lblEmpty" Style="{StaticResource MutedText}" HorizontalAlignment="Center" VerticalAlignment="Center"
                               TextAlignment="Center" IsHitTestVisible="False" Visibility="Collapsed" />
                </Grid>
            </Border>

            <!-- Count + what happened to the selected job -->
            <Border Grid.Row="2" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="0,1,0,0" Padding="20,12,20,14">
                <StackPanel>
                    <TextBlock x:Name="lblCount" Style="{StaticResource MutedText}" FontSize="12.5" Margin="0,0,0,6" />
                    <TextBlock x:Name="lblHistoryTitle" Text="Select a row to see every step the machine reported for it." Style="{StaticResource MutedText}" FontSize="12.5" />
                    <ListBox x:Name="lstHistory" MaxHeight="150" Margin="0,8,0,0" BorderThickness="0" Background="Transparent"
                             FontFamily="{StaticResource MonoFont}" FontSize="13" Visibility="Collapsed"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding EventAtText}" Foreground="{StaticResource MutedBrush}" />
                                    <TextBlock Grid.Column="1" Text="{Binding EventType}" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="2" Text="{Binding Detail}" TextWrapping="Wrap" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
