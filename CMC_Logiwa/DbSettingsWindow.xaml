<Window x:Class="CMC_Logiwa.DbSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CMC Logiwa – Database settings"
        Width="480" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource AppBgBrush}"
        Foreground="{StaticResource TextBrush}" FontFamily="{StaticResource UiFont}" UseLayoutRounding="True">
    <Grid Margin="24">
        <Border Style="{StaticResource Card}" Padding="32">
            <StackPanel>
                <TextBlock Text="Database settings" FontSize="22" FontWeight="SemiBold" />
                <TextBlock x:Name="lblIntro" TextWrapping="Wrap" Style="{StaticResource MutedText}" Margin="0,4,0,20"
                           Text="Where this PC's local database is. Saved encrypted on this PC only." />

                <Label Content="_Environment" Target="{Binding ElementName=cboEnvironment}" />
                <ComboBox x:Name="cboEnvironment" Margin="0,0,0,12" SelectionChanged="cboEnvironment_SelectionChanged">
                    <ComboBoxItem Content="DEV" />
                    <ComboBoxItem Content="PRO" />
                </ComboBox>

                <Label Content="_Server" Target="{Binding ElementName=txtServer}" />
                <TextBox x:Name="txtServer" Margin="0,0,0,12" />

                <Label Content="_Database" Target="{Binding ElementName=txtDatabase}" />
                <TextBox x:Name="txtDatabase" Margin="0,0,0,12" />

                <Label Content="SQL _login" Target="{Binding ElementName=txtUser}" />
                <TextBox x:Name="txtUser" Margin="0,0,0,12" />

                <Label Content="_Password" Target="{Binding ElementName=txtPassword}" />
                <PasswordBox x:Name="txtPassword" Margin="0,0,0,4" />
                <TextBlock x:Name="lblPasswordHint" Style="{StaticResource MutedText}" Margin="0,0,0,12"
                           Text="Leave blank to keep the saved password." Visibility="Collapsed" />

                <TextBlock Text="Web service (labels from Logiwa)" FontWeight="SemiBold" Margin="0,8,0,2" />
                <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,10"
                           Text="Where this PC gets its orders and labels. Leave both empty to run without it." />

                <Label Content="Web service _address" Target="{Binding ElementName=txtWebUrl}" />
                <TextBox x:Name="txtWebUrl" Margin="0,0,0,12" />

                <Label Content="_API key" Target="{Binding ElementName=txtApiKey}" />
                <PasswordBox x:Name="txtApiKey" Margin="0,0,0,4" />
                <TextBlock x:Name="lblApiKeyHint" Style="{StaticResource MutedText}" Margin="0,0,0,12"
                           Text="Leave blank to keep the saved key." Visibility="Collapsed" />

                <TextBlock x:Name="lblStatus" TextWrapping="Wrap" Margin="0,4,0,12" Visibility="Collapsed" />

                <Button x:Name="btnSave" Content="Test and save" Style="{StaticResource PrimaryButton}"
                        MinHeight="42" IsDefault="True" Click="btnSave_Click" />
                <Button x:Name="btnCancel" Content="Cancel" Style="{StaticResource SecondaryButton}"
                        MinHeight="42" Margin="0,8,0,0" IsCancel="True" Click="btnCancel_Click" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
