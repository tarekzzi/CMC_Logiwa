<Window x:Class="CMC_Logiwa.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CMC Logiwa – Settings"
        Width="860" Height="700" MinWidth="760" MinHeight="600"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource AppBgBrush}"
        Foreground="{StaticResource TextBrush}" FontFamily="{StaticResource UiFont}" FontSize="14"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Settings" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,12" />

        <TabControl x:Name="tabsSettings" Grid.Row="1">
            <!-- ===== Users ===== -->
            <TabItem Header="Users">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" MinHeight="140" />
                        <RowDefinition Height="14" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource Card}" Padding="0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <StackPanel Margin="20,14,20,12">
                                <TextBlock Text="People who can log in on this PC" FontSize="16" FontWeight="SemiBold" />
                                <TextBlock x:Name="lblUsersInfo" Style="{StaticResource MutedText}" FontSize="12.5" Margin="0,2,0,0" />
                            </StackPanel>
                            <Border Grid.Row="1" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="0,1,0,0">
                                <DataGrid x:Name="gridUsers" SelectionChanged="gridUsers_SelectionChanged">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="User name" Binding="{Binding Username}" Width="*" MinWidth="180" />
                                        <DataGridTextColumn Header="Role" Binding="{Binding RoleText}" Width="130" />
                                        <DataGridTextColumn Header="Status" Binding="{Binding StatusText}" Width="130" />
                                        <DataGridTextColumn Header="Created" Binding="{Binding CreatedText}" Width="120" />
                                        <DataGridTextColumn Header="Last login" Binding="{Binding LastLoginText}" Width="160" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Border>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border x:Name="cardAddUser" Grid.Column="0" Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Add a user" Style="{StaticResource CardTitle}" />
                                <Label Content="User name" Target="{Binding ElementName=txtNewUser}" />
                                <TextBox x:Name="txtNewUser" Margin="0,0,0,10" />
                                <Label Content="Password" Target="{Binding ElementName=txtNewPassword}" />
                                <PasswordBox x:Name="txtNewPassword" Margin="0,0,0,10" />
                                <Label Content="Password again" Target="{Binding ElementName=txtNewPassword2}" />
                                <PasswordBox x:Name="txtNewPassword2" Margin="0,0,0,10" />
                                <CheckBox x:Name="chkNewAdmin" Content="Administrator (manages users and settings)" Margin="0,0,0,14" />
                                <Button x:Name="btnAddUser" Content="Add user" Style="{StaticResource PrimaryButton}" MinHeight="40" Click="btnAddUser_Click" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock x:Name="lblSelected" Text="Selected user" Style="{StaticResource CardTitle}" />
                                <Label Content="New password" Target="{Binding ElementName=txtResetPassword}" />
                                <PasswordBox x:Name="txtResetPassword" Margin="0,0,0,10" />
                                <Label Content="Password again" Target="{Binding ElementName=txtResetPassword2}" />
                                <PasswordBox x:Name="txtResetPassword2" Margin="0,0,0,14" />
                                <Button x:Name="btnSetPassword" Content="Set password" Style="{StaticResource PrimaryButton}" MinHeight="40" Click="btnSetPassword_Click" />
                                <Button x:Name="btnToggleActive" Content="Switch off" MinHeight="40" Margin="0,8,0,0" Click="btnToggleActive_Click" />
                                <Button x:Name="btnToggleAdmin" Content="Make administrator" MinHeight="40" Margin="0,8,0,0" Click="btnToggleAdmin_Click" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- ===== Machine ===== -->
            <TabItem x:Name="tabMachine" Header="Machine">
                <Border Style="{StaticResource Card}" VerticalAlignment="Top">
                    <StackPanel MaxWidth="520" HorizontalAlignment="Left">
                        <TextBlock Text="CMC machine on this PC" Style="{StaticResource CardTitle}" />
                        <TextBlock Text="Saved in this PC's database. The Machine tab uses these values; every change is logged."
                                   Style="{StaticResource MutedText}" FontSize="12.5" TextWrapping="Wrap" Margin="0,0,0,14" />

                        <Label Content="Machine ID" Target="{Binding ElementName=txtMachineIdSetting}" />
                        <TextBox x:Name="txtMachineIdSetting" TextChanged="MarkUnsaved" MaxLength="20" Margin="0,0,0,12" />

                        <Label Content="IP address of the machine" Target="{Binding ElementName=txtIpSetting}" />
                        <TextBox x:Name="txtIpSetting" TextChanged="MarkUnsaved" MaxLength="100" Margin="0,0,0,12" />

                        <Label Content="Port" Target="{Binding ElementName=txtPortSetting}" />
                        <TextBox x:Name="txtPortSetting" TextChanged="MarkUnsaved" MaxLength="5" Width="120" HorizontalAlignment="Left" Margin="0,0,0,12" />

                        <Label Content="Warehouse this machine serves" Target="{Binding ElementName=cboWarehouse}" />
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="cboWarehouse" MinHeight="38" SelectionChanged="MarkUnsaved" />
                            <Button x:Name="btnReloadWarehouses" Grid.Column="2" Content="Reload" MinHeight="38" Padding="16,0" Click="btnReloadWarehouses_Click"
                                    ToolTip="Ask Logiwa (through the web service) for the warehouses again" />
                        </Grid>
                        <TextBlock x:Name="lblWarehouseHint" Style="{StaticResource MutedText}" FontSize="12.5" TextWrapping="Wrap" Margin="0,0,0,12" />

                        <CheckBox x:Name="chkAutoSetting" Click="MarkUnsaved" Content="Reconnect automatically if the link drops" Margin="0,0,0,16" />

                        <Button x:Name="btnSaveMachine" Content="Save machine settings" Style="{StaticResource PrimaryButton}"
                                HorizontalAlignment="Left" MinHeight="40" Padding="18,0" Click="btnSaveMachine_Click" />
                        <TextBlock x:Name="lblMachineHint" Style="{StaticResource MutedText}" FontSize="12.5" TextWrapping="Wrap" Margin="0,10,0,0" />
                    </StackPanel>
                </Border>
            </TabItem>

            <!-- ===== Connection ===== -->
            <TabItem x:Name="tabConnection" Header="Database and web service">
                <Border Style="{StaticResource Card}" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="This PC" Style="{StaticResource CardTitle}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Environment" Style="{StaticResource MutedText}" Margin="0,0,0,8" />
                            <TextBlock x:Name="valEnvironment" Grid.Column="1" Margin="0,0,0,8" />
                            <TextBlock Grid.Row="1" Text="Database server" Style="{StaticResource MutedText}" Margin="0,0,0,8" />
                            <TextBlock x:Name="valServer" Grid.Row="1" Grid.Column="1" Margin="0,0,0,8" />
                            <TextBlock Grid.Row="2" Text="Database" Style="{StaticResource MutedText}" Margin="0,0,0,8" />
                            <TextBlock x:Name="valDatabase" Grid.Row="2" Grid.Column="1" Margin="0,0,0,8" />
                            <TextBlock Grid.Row="3" Text="Web service address" Style="{StaticResource MutedText}" Margin="0,0,0,8" />
                            <TextBlock x:Name="valWeb" Grid.Row="3" Grid.Column="1" Margin="0,0,0,8" TextWrapping="Wrap" />
                            <TextBlock Grid.Row="4" Text="API key" Style="{StaticResource MutedText}" />
                            <TextBlock x:Name="valKey" Grid.Row="4" Grid.Column="1" />
                        </Grid>

                        <Button x:Name="btnChangeDb" Content="Change database and web service settings…" HorizontalAlignment="Left"
                                MinHeight="40" Padding="18,0" Margin="0,20,0,0" Click="btnChangeDb_Click" />
                        <TextBlock x:Name="lblChangeHint" Style="{StaticResource MutedText}" FontSize="12.5" TextWrapping="Wrap" Margin="0,8,0,0" />

                        <TextBlock Text="Environment" Style="{StaticResource CardTitle}" Margin="0,24,0,4" />
                        <TextBlock x:Name="lblEnvInfo" Style="{StaticResource MutedText}" FontSize="12.5" TextWrapping="Wrap" Margin="0,0,0,10" />
                        <Button x:Name="btnSwitchEnv" Content="Switch to PRO" HorizontalAlignment="Left" MinHeight="40" Padding="18,0" Click="btnSwitchEnv_Click" />
                    </StackPanel>
                </Border>
            </TabItem>

            <!-- ===== Web VM / Logiwa (administrators): settings of the web VM, stored there, applied without a restart ===== -->
            <TabItem x:Name="tabWeb" Header="Web VM / Logiwa">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="lblWebIntro" Style="{StaticResource MutedText}" FontSize="12.5" TextWrapping="Wrap" VerticalAlignment="Center"
                                   Text="Settings of the web VM (the link between this PC and Logiwa). Stored on the web VM, in force within seconds, no restart. Saving needs the administrator key." />
                        <Button x:Name="btnWebReload" Grid.Column="1" Content="Reload" MinHeight="36" Padding="16,0" Margin="12,0,0,0" Click="btnWebReload_Click" />
                    </Grid>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="panelWeb" Margin="0,0,8,0" />
                    </ScrollViewer>
                    <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,10,0,0" Padding="16,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="260" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Label Content="Administrator key" Target="{Binding ElementName=txtAdminKey}" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <PasswordBox x:Name="txtAdminKey" Grid.Column="1" VerticalAlignment="Center"
                                         ToolTip="Typed for every save, never stored on this PC. Made with DOC\New-CmcApiKey.ps1 -Admin." />
                            <Button x:Name="btnWebSave" Grid.Column="3" Content="Save changes" Style="{StaticResource PrimaryButton}"
                                    MinHeight="40" Padding="18,0" Margin="12,0,0,0" Click="btnWebSave_Click" />
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>

        <Grid Grid.Row="2" Margin="0,14,0,0">
            <TextBlock x:Name="lblStatus" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,140,0" />
            <Button Content="Close" MinWidth="110" MinHeight="40" HorizontalAlignment="Right" IsCancel="True" IsDefault="True" Click="btnClose_Click" />
        </Grid>
    </Grid>
</Window>
